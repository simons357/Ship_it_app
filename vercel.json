{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo skip",
  "buildCommand": "cp -f TITAN-X-FINAL-Investor-Plan.pdf titan-x-web/TITAN-X-FINAL-Investor-Plan.pdf",
  "outputDirectory": "titan-x-web",
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- titan-x-web vercel.json TITAN-X-FINAL-Investor-Plan.pdf",
  "rewrites": [
    { "source": "/apps/explorer/assets/:path*", "destination": "/apps/explorer/assets/:path*" },
    { "source": "/apps/maritime/assets/:path*", "destination": "/apps/maritime/assets/:path*" },
    { "source": "/apps/solenne/assets/:path*", "destination": "/apps/solenne/assets/:path*" },
    { "source": "/apps/primefield/assets/:path*", "destination": "/apps/primefield/assets/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
