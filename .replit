run = "python3 -m domain_architect --site --site-host 0.0.0.0 --site-port 8080"
entrypoint = "domain_architect/__main__.py"
hidden = [".git", "__pycache__", ".venv"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "python3 -m domain_architect --site --site-host 0.0.0.0 --site-port 8080"]

[env]
PYTHONUNBUFFERED = "1"
